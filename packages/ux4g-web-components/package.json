{
  "name": "ux4g-web-components",
  "version": "3.0.3",
  "type": "module",
  "description": "UX4G Design System — complete CSS bundle with 57 components, 66 citizen journey patterns, 8 service patterns, 37 utility modules (3,681 mapped classes), 594 primitive + 554 semantic design tokens, dark mode theme, and runtime. All values in rem for accessible scaling. Use CSS classes directly in HTML/React/Angular.",
  "keywords": [
    "design-system",
    "css",
    "components",
    "ui",
    "ux4g",
    "button",
    "spinner",
    "modal",
    "dropdown",
    "table",
    "card",
    "accordion",
    "tab",
    "drawer",
    "alert",
    "tooltip",
    "popover",
    "badge",
    "avatar",
    "chip",
    "tag",
    "input",
    "checkbox",
    "radio",
    "switch",
    "breadcrumb",
    "divider",
    "link",
    "image",
    "stepper",
    "pagination",
    "navbar",
    "carousel",
    "icon-button",
    "search",
    "file-upload",
    "otp-input",
    "slider",
    "combobox",
    "progress-indicator",
    "date-time-picker",
    "form-field-group",
    "empty-state",
    "feedback",
    "footer",
    "draft-status",
    "result-list",
    "time-slot",
    "social-link",
    "select",
    "scroll-snap",
    "transitions",
    "transforms",
    "effects",
    "css-utilities",
    "design-tokens",
    "dark-mode",
    "themes",
    "patterns",
    "layout",
    "typography",
    "spacing",
    "rem",
    "flexbox",
    "grid",
    "responsive",
    "accessibility",
    "wcag",
    "react",
    "angular",
    "html",
    "web-components",
    "government",
    "enterprise",
    "india"
  ],
  "scripts": {
    "build:css": "node scripts/build-css.mjs",
    "build:types": "rollup -c rollup.config.mjs",
    "build": "npm run build:css && npm run build:types",
    "prepublishOnly": "npm run build",
    "test": "jest"
  },
  "exports": {
    "./styles.css": {
      "default": "./styles/ux4g.css"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.mjs",
      "require": "./dist/types/index.cjs",
      "default": "./dist/types/index.mjs"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.mjs",
      "require": "./dist/runtime/index.cjs",
      "default": "./dist/runtime/index.mjs"
    },
    "./runtime/bootstrap": {
      "types": "./dist/runtime/bootstrap.d.ts",
      "import": "./dist/runtime/bootstrap.mjs",
      "require": "./dist/runtime/bootstrap.cjs",
      "default": "./dist/runtime/bootstrap.mjs"
    },
    "./design-system": {
      "types": "./dist/runtime/bootstrap.d.ts",
      "import": "./dist/runtime/design-system.mjs",
      "require": "./dist/runtime/design-system.cjs",
      "default": "./dist/runtime/design-system.mjs"
    }
  },
  "typesVersions": {
    "*": {
      "types": [
        "./dist/types/index.d.ts"
      ],
      "runtime": [
        "./dist/runtime/index.d.ts"
      ],
      "runtime/bootstrap": [
        "./dist/runtime/bootstrap.d.ts"
      ],
      "design-system": [
        "./dist/runtime/bootstrap.d.ts"
      ]
    }
  },
  "sideEffects": [
    "./dist/runtime/bootstrap.mjs",
    "./dist/runtime/bootstrap.cjs",
    "./dist/runtime/bootstrap.js",
    "./dist/runtime/index.mjs",
    "./dist/runtime/index.cjs",
    "./dist/runtime/index.js",
    "./dist/runtime/design-system.mjs",
    "./dist/runtime/design-system.cjs",
    "./dist/runtime/design-system.js"
  ],
  "files": [
    "README.md",
    "CHANGELOG.md",
    "styles/ux4g.css",
    "dist/",
    "dist/runtime/"
  ],
  "devDependencies": {
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-typescript": "^12.0.0",
    "@types/jest": "^29.5.14",
    "cssnano": "^7.0.0",
    "fast-check": "^3.23.2",
    "jest": "^29.7.0",
    "postcss": "^8.4.0",
    "postcss-import": "^16.1.1",
    "postcss-url": "^10.1.3",
    "rollup": "^4.0.0",
    "ts-jest": "^29.4.9",
    "tslib": "^2.8.1",
    "typescript": "^5.6.3"
  }
}
